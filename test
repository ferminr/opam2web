#!/bin/bash -ue

usage() {
  cat <<USAGE
Build the opam website locally, for testing.

usage: $0 --input-dir INPUT_DIR --output-dir OUTPUT_DIR
  --input-dir INPUT_DIR    existing directory; the inputs listed below are fetched into it when absent
  --output-dir OUTPUT_DIR  existing directory
  --dry-run                show the commands that would be run, without running them
  -h, --help               show full description
USAGE
}

help() {
  usage
  cat <<HELP

The generated website is written to OUTPUT_DIR/opamweb; open OUTPUT_DIR/opamweb/index.html to browse it. OUTPUT_DIR is also used as scratch space: some directories are (re)created there on every run.

The contents of INPUT_DIR are fetched on the first run; any subdir that is already there is left alone:

  git clone git@github.com:ocaml/opam-repository.git INPUT_DIR/opam-repository
  git clone https://github.com/ocaml/opam.wiki.git INPUT_DIR/opam.wiki
  git clone https://github.com/ocaml/opam.wiki.git --depth 1 -b old_wiki INPUT_DIR/opam.old_wiki
  mkdir INPUT_DIR/doc_html_files && touch INPUT_DIR/doc_html_files/{Manual,Packaging,Install,Usage}.html

These inputs rarely change, while this script is meant to be run multiple times while developing opam2web, so re-fetching on every run would be wasteful. Update them yourself (git pull) when you want newer ones.

The static documentation pages will be empty if we use empty files as inputs (Manual.html, ...), and that's fine if we are mainly interested in testing the Packages part of the website. The full website can be generated with a docker script as described in the README file.

The run ends with '[ERROR] No top10 packages statistics'. This is expected: the package download counts come from the server logs of opam.ocaml.org, which are not given as input to opam2web in this script.
HELP
}

INPUT_DIR=
OUTPUT_DIR=
DRY_RUN=

while [ $# -gt 0 ]; do
  case $1 in
    --input-dir)
      [ $# -ge 2 ] || { echo "$0: $1 requires an argument" >&2; exit 1; }
      INPUT_DIR=$2; shift 2 ;;
    --input-dir=*)
      INPUT_DIR=${1#*=}; shift ;;
    --output-dir)
      [ $# -ge 2 ] || { echo "$0: $1 requires an argument" >&2; exit 1; }
      OUTPUT_DIR=$2; shift 2 ;;
    --output-dir=*)
      OUTPUT_DIR=${1#*=}; shift ;;
    --dry-run)
      DRY_RUN=1; shift ;;
    -h|--help)
      help; exit 0 ;;
    *)
      echo "$0: unknown argument '$1'" >&2
      usage >&2
      exit 1 ;;
  esac
done

if [ -z "$INPUT_DIR" ] || [ -z "$OUTPUT_DIR" ]; then
  echo "$0: --input-dir and --output-dir are both required" >&2
  usage >&2
  exit 1
fi

if [ ! -d "$INPUT_DIR" ]; then
  echo "$0: --input-dir '$INPUT_DIR' is not a directory" >&2
  exit 1
fi

if [ ! -d "$OUTPUT_DIR" ]; then
  echo "$0: --output-dir '$OUTPUT_DIR' is not a directory" >&2
  exit 1
fi

INPUT_DIR=$(cd "$INPUT_DIR" && pwd)
OUTPUT_DIR=$(cd "$OUTPUT_DIR" && pwd)
SRC_DIR=$(cd "$(dirname "$0")" && pwd)

# run COMMAND...: log the command, then run it unless --dry-run was given
run() {
  echo "  $*"
  if [ -z "$DRY_RUN" ]; then
    "$@"
  fi
}

# run_cmd DIR COMMAND...: like run, but suggest clearing DIR on failure
run_cmd() {
  local dir=$1; shift
  echo "  $*"
  if [ -n "$DRY_RUN" ]; then
    return 0
  fi
  if ! "$@"; then
    echo "$0: command failed: $*" >&2
    echo "$0: '$dir' may have been partially created; delete it before running this script again" >&2
    exit 1
  fi
}

for d in opam-repository opam.wiki opam.old_wiki doc_html_files; do
  if [ -d "$INPUT_DIR/$d" ]; then
    continue
  fi
  echo "$INPUT_DIR/$d does not exist, creating it with:"
  case $d in
    opam-repository)
      run_cmd "$INPUT_DIR/$d" git clone git@github.com:ocaml/opam-repository.git "$INPUT_DIR/$d" ;;
    opam.wiki)
      run_cmd "$INPUT_DIR/$d" git clone https://github.com/ocaml/opam.wiki.git "$INPUT_DIR/$d" ;;
    opam.old_wiki)
      run_cmd "$INPUT_DIR/$d" git clone https://github.com/ocaml/opam.wiki.git --depth 1 -b old_wiki "$INPUT_DIR/$d" ;;
    doc_html_files)
      run_cmd "$INPUT_DIR/$d" mkdir "$INPUT_DIR/$d"
      run_cmd "$INPUT_DIR/$d" touch "$INPUT_DIR/$d/Manual.html" "$INPUT_DIR/$d/Packaging.html" \
                                    "$INPUT_DIR/$d/Install.html" "$INPUT_DIR/$d/Usage.html" ;;
  esac
done

cd "$OUTPUT_DIR"
run rm -rf opam-repository content opamweb ext json

echo "preparing inputs"
run git clone "$INPUT_DIR/opam-repository" ./opam-repository
run cp -r "$SRC_DIR/content" .
run mkdir -p content/doc/{1.1,1.2,2.0,api,man}
run cp -r "$INPUT_DIR"/opam.wiki/* content/doc/1.1
run cp "$INPUT_DIR"/opam.old_wiki/opam11_note.md content/doc/1.1
run cp -r "$INPUT_DIR"/doc_html_files/* content/doc

run cp -r -L "$SRC_DIR/ext" .
run mkdir -p opamweb
run cp -r -L "$SRC_DIR/ext" ./opamweb

echo "running opam2web"
run "$SRC_DIR/_build/default/bin/opam2web.exe" --content content --output ./opamweb -r 'http://127.0.0.1:8080' ./opam-repository
